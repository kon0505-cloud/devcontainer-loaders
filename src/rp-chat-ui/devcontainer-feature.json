{
  "id": "rp-chat-ui",
  "version": "1.0.4",
  "name": "RP-Chat-UI Symlink Installer",
  "description": "Mounts host RP-Chat-UI directory and links it directly to VS Code extensions.",
  "mounts": [
    {
      "source": "${localEnv:SystemDrive}/OneDrive/DevContainers/opt/rp-chat-ui",
      "target": "/opt/rp-chat-ui",
      "type": "bind"
    }
  ],
  "postStartCommand": "if [ -f /opt/rp-chat-ui/devcontainer-hooks/post-start.sh ]; then bash /opt/rp-chat-ui/devcontainer-hooks/post-start.sh; fi"
}
