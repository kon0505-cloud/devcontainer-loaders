{
  "id": "rp-chat-ui",
  "version": "1.0.2",
  "name": "RP-Chat-UI Symlink Installer",
  "description": "Mounts host RP-Chat-UI directory and links it directly to VS Code extensions.",
  "mounts": [
    {
      "source": "${localEnv:SystemDrive}${localEnv:HOME}/OneDrive/Omochi/Antigravity/rp-chat-ui",
      "target": "/var/rp-chat-ui",
      "type": "bind"
    }
  ],
  "postStartCommand": "mkdir -p ~/.vscode-server/extensions && ln -sfn /var/rp-chat-ui ~/.vscode-server/extensions/yun-komochi.rp-chat-ui-0.1.0 && bash /usr/local/share/rp-chat-ui/link-agents.sh"
}
