{
  "id": "gemini-tools",
  "version": "1.0.4",
  "name": "My Gemini Tools",
  "description": "Common Gemini data mounts, scripts, and lifecycle hooks",
  "mounts": [
    {
      "source": "devcontainer-gemini-data-${devcontainerId}",
      "target": "/var/gemini-data",
      "type": "volume"
    },
    {
      "source": "devcontainer-node_modules-${devcontainerId}",
      "target": "${containerWorkspaceFolder}/node_modules",
      "type": "volume"
    },
    {
      "source": "${localEnv:USERPROFILE}/.gitconfig",
      "target": "/var/host-gitconfig",
      "type": "bind"
    },
    {
      "source": "${localEnv:SystemDrive}/OneDrive/DevContainers/opt/gemini-tools",
      "target": "/opt/gemini-tools",
      "type": "bind"
    }
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "google.google-antigravity",
        "natqe.reload"
      ]
    }
  },
  "postCreateCommand": "if [ -f /opt/gemini-tools/devcontainer-hooks/post-create.sh ]; then bash /opt/gemini-tools/devcontainer-hooks/post-create.sh; fi",
  "postStartCommand": "if [ -f /opt/gemini-tools/devcontainer-hooks/post-start.sh ]; then bash /opt/gemini-tools/devcontainer-hooks/post-start.sh; fi",
  "postAttachCommand": "if [ -f /opt/gemini-tools/devcontainer-hooks/post-attach.sh ]; then bash /opt/gemini-tools/devcontainer-hooks/post-attach.sh; fi"
}

