{
  "id": "novel-tools",
  "version": "1.0.1",
  "name": "My Novel Tools",
  "description": "小説の執筆に役立つスクリプトをまとめたフォルダ",
  "mounts": [
    {
      "source": "${localEnv:SystemDrive}/OneDrive/DevContainers/opt/novel-tools",
      "target": "/opt/novel-tools",
      "type": "bind"
    }
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "3w36zj6.textlint",
        "ritwickdey.liveserver"
      ]
    }
  },
  "postStartCommand": "if [ -f /opt/novel-tools/devcontainer-hooks/post-start.sh ]; then bash /opt/novel-tools/devcontainer-hooks/post-start.sh; fi"
}

