{
  "id": "rp-chat-agent",
  "version": "1.0.0",
  "name": "RP-Chat-Agent",
  "description": "拡張機能RP-Chat-UI用のagentsファイルを配信",
  "mounts": [
    {
      "source": "${localEnv:SystemDrive}/OneDrive/DevContainers/opt/rp-chat-agent",
      "target": "/opt/rp-chat-agent",
      "type": "bind"
    }
  ],
  "postStartCommand": "if [ -f /opt/rp-chat-agent/devcontainer-hooks/post-start.sh ]; then bash /opt/rp-chat-agent/devcontainer-hooks/post-start.sh; fi"
}
