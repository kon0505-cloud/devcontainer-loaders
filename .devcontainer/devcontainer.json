{
  "name": "devcontainer-loaders",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:24-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/powershell:2": {},
    "ghcr.io/devcontainers/features/python:1": {
      "version": "latest"
    },
    "ghcr.io/kon0505-cloud/devcontainer-loaders/gemini-tools:1": {},
    "ghcr.io/kon0505-cloud/devcontainer-loaders/novel-tools:1": {},
    "ghcr.io/kon0505-cloud/devcontainer-loaders/rp-chat-ui:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.powershell"
      ],
      "settings": {
        "powershell.powerShellDefaultVersion": "PowerShell"
      }
    }
  },
  "postCreateCommand": "pwsh -Command 'Install-Module -Name PSScriptAnalyzer, Pester -Force -Scope CurrentUser'"
}